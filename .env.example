# Global Tours Firebase client configuration
# These values are client-side Firebase identifiers, not server secrets.
# Obtain them from Firebase Console / FlutterFire configuration.

FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_MESSAGING_SENDER_ID
FIREBASE_APP_ID=REPLACE_WITH_WEB_APP_ID
FIREBASE_ANDROID_APP_ID=REPLACE_WITH_ANDROID_APP_ID
FIREBASE_IOS_APP_ID=REPLACE_WITH_IOS_APP_ID
FIREBASE_IOS_BUNDLE_ID=com.globaltours.hometour
FIREBASE_MEASUREMENT_ID=
DEFAULT_TENANT_ID=
